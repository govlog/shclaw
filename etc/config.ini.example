; shclaw global configuration

[daemon]
data_dir = ./data
log_dir  = ./logs
; Minutes of silence that close the conversation with the owner (0: none)
;conversation_timeout = 15

; Remove this section to run without IRC (TUI and CLI only).
; Port 6697 uses TLS.
[irc]
server   = irc.example.com
port     = 6697
nick     = mybot
channel  = #mychannel
owner    = yournick

; --- LLM Providers ---
; Optional keys: max_tokens (output limit per call), timeout (seconds
; without data before a call fails, default 600), reasoning_effort (OpenAI
; protocol; gpt-6-* models need "none" to accept function tools)

[provider.anthropic]
type     = anthropic
api_key  = sk-ant-CHANGEME

[provider.openai]
type     = openai
api_key  = sk-CHANGEME

; Ollama (local, no API key needed). Also start the Ollama server with a
; larger context, e.g. OLLAMA_CONTEXT_LENGTH=16384.
;[provider.ollama]
;type     = openai
;base_url = http://localhost:11434
;api_key  =
;timeout  = 900

; --- Model tiers ---
; Format: provider_name/model_id

[tiers]
simple   = anthropic/claude-haiku-4-5
standard = anthropic/claude-sonnet-5-5
complex  = anthropic/claude-opus-5-5
